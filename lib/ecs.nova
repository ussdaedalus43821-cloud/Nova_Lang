# lib/ecs.nova - a small, real Entity-Component-System.
#
# Import it with:  import "../lib/ecs.nova" with world_new, spawn_entity, ...
# (adjust the "../" to however many directories separate your script from
# lib/ - NovaLang resolves imports relative to the importing file).
#
# WHAT THIS DOES AND DOES NOT DO - read this before using it for a
# particle system. This ECS is built for GAMEPLAY-scale entities: things
# like emitters, force fields, and interaction modes - tens to a few
# thousand of them, all managed every frame with real query performance.
# It is explicitly NOT where 25,000-50,000 simulated particles live.
#
# Why: NovaLang is a tree-walking interpreter (no bytecode, no JIT -
# every operation is a Python function call walking an AST node).
# Benchmarked directly in this interpreter: a bare arithmetic loop runs
# at ~162,000 iterations/sec, and a realistic per-entity physics update
# (dict field reads/writes) runs at ~41,000-66,000 entities/sec. At
# 50,000 particles, just the movement update alone would cost ~750ms -
# 45x an entire 16.7ms/frame budget at 60fps - before collision detection
# (which costs MORE per entity than movement, not less) touches anything.
# No amount of query-mask cleverness changes a constant-factor interpreter
# ceiling; that only fixes algorithmic complexity, and the complexity was
# never the bottleneck at these counts.
#
# So the actual particle data (positions, velocities, colors - tens of
# thousands of them) lives in NumPy arrays in Python
# (examples/particle_engine.py), updated with vectorized array
# operations, which is the only way to get from "tens of thousands of
# ops/sec" to the "tens of millions of ops/sec" 50,000 particles at 60fps
# actually requires. This ECS's entities describe and steer that
# simulation - "spawn 500 particles here", "there's a repulsor field at
# (x,y) with this strength", "the mouse currently attracts" - and
# examples/ecs_particles.nova's world_step() returns a small, plain
# summary of that state once a frame for examples/ecs_demo.py to apply
# to the real particle arrays. See that file and the README's
# Architecture section for the full picture.
#
# ---------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------
# Entities are plain integers. Components are named values attached to
# an entity id - anything a dict/list/number/string can hold, no
# predefined shape required (e.g. "position" -> {x: 1.0, y: 2.0}).
#
# A world is one dict:
#   entities:       {"<id>": true, ...}            - which ids are alive
#   components:      {"<name>": {"<id>": value}}     - component storage
#   masks:            {"<id>": <int bitmask>}          - which components each entity has
#   component_bits:    {"<name>": <int, a power of two>} - name -> mask bit
#   next_bit:           <int, a power of two>                - next unused bit
#   next_entity_id:      <int>                                 - id allocator
#
# Dict keys in NovaLang must be strings (numbers can't index a dict
# directly), so entity ids are converted with str() everywhere below -
# entity_key(id) does that conversion in one place.
#
# ---------------------------------------------------------------------
# Component masks, without a bitwise-AND operator
# ---------------------------------------------------------------------
# NovaLang has no &/|/<<  operators, so masks are tested and combined
# with plain arithmetic instead - a standard trick, not a workaround:
# every component bit is a power of two, and "is bit b set in mask m"
# is exactly `(m // b) % 2 == 1` (integer-dividing away the lower bits,
# then reading the resulting lowest one). mask_has()/mask_add()/
# mask_remove() below are the only three places that need to know this.

export def entity_key(entity_id) {
    return str(entity_id)
}

export def world_new() {
    return {
        entities: {},
        components: {},
        masks: {},
        component_bits: {},
        next_bit: 1,
        next_entity_id: 1
    }
}

export def mask_has(mask, bit) {
    return (mask // bit) % 2 == 1
}

export def mask_add(mask, bit) {
    if mask_has(mask, bit) {
        return mask
    }
    return mask + bit
}

export def mask_remove(mask, bit) {
    if mask_has(mask, bit) {
        return mask - bit
    }
    return mask
}

export def component_bit(world, name) {
    # Every component name gets one bit, assigned the first time it's
    # seen and reused after that - so masks stay comparable across the
    # whole world's lifetime.
    if name in world.component_bits {
        return world.component_bits[name]
    }
    let bit = world.next_bit
    world.component_bits[name] = bit
    world.next_bit = bit * 2
    return bit
}

export def spawn_entity(world) {
    let id = world.next_entity_id
    world.next_entity_id = id + 1
    world.entities[entity_key(id)] = true
    world.masks[entity_key(id)] = 0
    return id
}

export def despawn_entity(world, entity_id) {
    let key = entity_key(entity_id)
    if not (key in world.entities) {
        return false
    }
    for name in keys(world.components) {
        delete world.components[name][key]
    }
    delete world.entities[key]
    delete world.masks[key]
    return true
}

export def is_alive(world, entity_id) {
    return entity_key(entity_id) in world.entities
}

export def set_component(world, entity_id, name, value) {
    let key = entity_key(entity_id)
    if not (key in world.entities) {
        throw("set_component: entity " + str(entity_id) + " does not exist")
    }
    if not (name in world.components) {
        world.components[name] = {}
    }
    world.components[name][key] = value
    let bit = component_bit(world, name)
    world.masks[key] = mask_add(world.masks[key], bit)
    return value
}

export def remove_component(world, entity_id, name) {
    let key = entity_key(entity_id)
    if not (name in world.components) {
        return false
    }
    if not (key in world.components[name]) {
        return false
    }
    delete world.components[name][key]
    let bit = component_bit(world, name)
    world.masks[key] = mask_remove(world.masks[key], bit)
    return true
}

export def has_component(world, entity_id, name) {
    let key = entity_key(entity_id)
    if not (name in world.component_bits) {
        return false
    }
    if not (key in world.masks) {
        return false
    }
    return mask_has(world.masks[key], world.component_bits[name])
}

let NOTHING_COMPONENT = "__ecs_no_such_component__"

export def get_component(world, entity_id, name) {
    let key = entity_key(entity_id)
    if not (name in world.components) {
        return NOTHING_COMPONENT
    }
    if not (key in world.components[name]) {
        return NOTHING_COMPONENT
    }
    return world.components[name][key]
}

# ---------------------------------------------------------------------
# Queries
# ---------------------------------------------------------------------
# query(world, names) returns every entity id that has ALL the named
# components - the actual "no O(n^2) scanning" part: rather than testing
# every entity in the world against every requested component, it walks
# only the SMALLEST of the requested components' entity sets once, and
# checks each candidate's bitmask against the rest (an O(1) arithmetic
# test, not a second scan). Cost is O(size of the smallest matching
# component set), never O(entity count in the world).

export def smallest_component(world, names) {
    let best_name = ""
    let best_size = -1
    for name in names {
        let size = 0
        if name in world.components {
            size = len(keys(world.components[name]))
        }
        if best_size == -1 or size < best_size {
            best_size = size
            best_name = name
        }
    }
    return best_name
}

export def query(world, names) {
    if len(names) == 0 {
        return []
    }
    let driver = smallest_component(world, names)
    if not (driver in world.components) {
        return []
    }

    let required_mask = 0
    for name in names {
        required_mask = mask_add(required_mask, component_bit(world, name))
    }

    let matches = []
    for key in keys(world.components[driver]) {
        let mask = world.masks[key]
        let has_all = true
        for name in names {
            if not mask_has(mask, world.component_bits[name]) {
                has_all = false
            }
        }
        if has_all {
            append(matches, num(key))
        }
    }
    return matches
}

# ---------------------------------------------------------------------
# Systems
# ---------------------------------------------------------------------
# A "system" here is just a NovaLang function of (world, dt, ...) that
# calls query() itself and does whatever it does to the matching
# entities - there's no separate registration mechanism to learn, since
# a NovaLang function already is the unit of reusable behavior. run_system
# is a convenience wrapper for the common case of "call fn(world, id, dt)
# once per matching entity":

export def run_system(world, names, fn, dt) {
    for id in query(world, names) {
        fn(world, id, dt)
    }
}
