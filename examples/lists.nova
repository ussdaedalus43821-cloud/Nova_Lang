# ---- lists and indexing ----
let a = [1, 2, 3, 4, 5]
let b = []
print(a, b, len(a), len(b))
print(a[0], a[-1], a[2])

a[0] = 10
print(a)

# ---- append and pop ----
append(a, 6)
print(a, len(a))
print(pop(a))          # last item
print(pop(a, 0))       # by index
print(a)

# ---- integer math ----
print(10 % 3, 10 // 3, 7 // 2, 2 + 3 * 4 % 5)
print(-7 // 2, -7 % 3)

# ---- concatenation and repetition ----
print([1, 2] + [3, 4])
print([1, 2] * 3)
print(3 * ["x"])
print(["a"] + ["b", "c"])

# ---- for ... in ----
for i in [1, 2, 3] {
    print(i)
}
for i in range(5) { print(i) }
for i in range(2, 8) { print(i) }
for i in range(0, 10, 2) { print(i) }
for i in range(5, 0, -1) { print(i) }

# ---- break / continue / else still work over lists ----
for word in ["alpha", "beta", "gamma"] {
    if word == "beta" { continue }
    print(word)
} else {
    print("walked the whole list")
}

# ---- lists in functions ----
def total(numbers) {
    let running_total = 0
    for n in numbers {
        running_total = running_total + n
    }
    return running_total
}
print("sum:", total(range(1, 101)))

def evens(limit) {
    let out = []
    for n in range(limit) {
        if n % 2 == 0 {
            append(out, n)
        }
    }
    return out
}
print(evens(12))

def fizzbuzz(limit) {
    # Lists hold any mix of values, so the numbers and the words can live
    # in the same list.
    let out = []
    for n in range(1, limit + 1) {
        if n % 15 == 0 {
            append(out, "fizzbuzz")
        } else if n % 3 == 0 {
            append(out, "fizz")
        } else if n % 5 == 0 {
            append(out, "buzz")
        } else {
            append(out, n)
        }
    }
    return out
}
print(fizzbuzz(15))

# ---- lists are references; let shadows, plain assignment updates ----
let shared = [1, 2, 3]
let alias = shared
alias[0] = 99
print("shared sees the change:", shared)

let x = 1
if true {
    let x = 2
    print("inner let:", x)
}
print("outer x is untouched:", x)

# ---- equality is element-wise ----
print([1, 2] == [1, 2], [1, 2] == [1, 3], [] == [])
