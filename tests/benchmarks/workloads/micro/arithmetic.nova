# micro: integer arithmetic and comparison in a loop.  ADD SUB MUL MOD FLOOR_DIV, EQ/LT, STORE_FAST.
def work(n) {
    let a = 1
    let b = 0
    let hits = 0
    for i = 1 to n {
        a = (a * 31 + i) % 1000003
        b = b + (a // 7) - (i % 5)
        if a % 3 == 0 {
            hits = hits + 1
        }
    }
    return a + b + hits
}
print(work(100000))
