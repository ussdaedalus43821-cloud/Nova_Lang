# micro: building strings: + on strings, str(), len(), indexing a string.
def work(n) {
    let out = ""
    let digits = 0
    for i = 1 to n {
        out = out + str(i) + ","
        if len(out) > 400 {
            digits = digits + len(out)
            out = ""
        }
    }
    return digits + len(out)
}
print(work(60000))
