# Found by station 11 (generator seed 352). A `return` inside a loop inside
# a try inlines the finally body - which must be compiled outside that
# loop, so its `break` is stray (an error), not a jump out of the loop.
# The finally ran twice on the VM; it must run once.
def leaves() {
    try {
        for total in [4, 1, 1, 5] {
            return "returned"
        }
    } finally {
        print("finally")
        break
    }
}
try {
    print(leaves())
} catch problem {
    print("caught:", problem)
}

def continues() {
    for outer in [1, 2] {
        try {
            for inner in [1] {
                return "returned"
            }
        } finally {
            print("finally", outer)
            continue  # the outer loop: the return is abandoned
        }
    }
    return "after the loop"
}
print(continues())
