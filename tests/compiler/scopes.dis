code <module>
  slots: 0=fresh@block, 1=local@block
             0 LOAD_CONST           0 (0)
     2       1 STORE_GLOBAL         seen
             2 LOAD_CONST           1 (True)
     3       3 JUMP_IF_NOT_TRUE     to 18 (if condition)
             4 RESET_SLOTS          0(fresh@block)
     4       5 LOAD_GLOBAL          seen
             6 LOAD_CONST           4 (1)
             7 ADD
             8 STORE_GLOBAL         seen
             9 LOAD_CONST           4 (1)
     5      10 STORE_CHAIN          5 (global:fresh -> fast:0)
            11 LOAD_CONST           6 (2)
     6      12 STORE_FAST           1 (local@block)
     7      13 LOAD_CONST           7 (<built-in print>)
            14 LOAD_CHAIN           8 (fast:0 -> global:fresh)
            15 LOAD_FAST            1 (local@block)
            16 CALL                 2
            17 POP
    10 >>   18 MAKE_FUNCTION        9 (<code counter>)
            19 STORE_GLOBAL         counter
    15      20 MAKE_FUNCTION        10 (<code shadow>)
            21 STORE_GLOBAL         shadow
    23      22 MAKE_FUNCTION        11 (<code reads_global_late>)
            23 STORE_GLOBAL         reads_global_late
            24 LOAD_CONST           4 (1)
            25 DUP
    26      26 STORE_GLOBAL         defined_after
            27 RETURN

code counter
  slots: 0=seen
             0 LOAD_CONST           0 (5)
    11       1 STORE_FAST           0 (seen)
    12       2 LOAD_FAST            0 (seen)
             3 RETURN
             4 LOAD_CONST           1 (nothing)
             5 RETURN

code shadow(x)
  slots: 0=x, 1=x@block
    16       0 LOAD_FAST            0 (x)
             1 LOAD_CONST           0 (0)
             2 GT
             3 JUMP_IF_NOT_TRUE     to 10 (if condition)
             4 LOAD_CONST           2 ('inner')
    17       5 STORE_FAST           1 (x@block)
    18       6 LOAD_CONST           3 (<built-in print>)
             7 LOAD_FAST            1 (x@block)
             8 CALL                 1
             9 POP
    20 >>   10 LOAD_FAST            0 (x)
            11 RETURN
            12 LOAD_CONST           4 (nothing)
            13 RETURN

code reads_global_late
    24       0 LOAD_GLOBAL          defined_after
             1 RETURN
             2 LOAD_CONST           0 (nothing)
             3 RETURN

