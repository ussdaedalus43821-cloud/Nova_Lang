# Data: ordering of checks, members, delete, slices, strings, logic.
let d = {name: "nova", tags: ["a", "b"]}
d["version"] = 1  # the key is checked before the value is evaluated
d.name = upper(d.name)
delete d.version
delete d["tags"]
let s = "hello"
print(s[1:3], s[:2], s[2:], f"{s} has {len(s)} letters", -len(s), not true)
let ok = (len(s) > 2 and s != "") or false
