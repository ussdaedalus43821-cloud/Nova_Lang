code returns_through_finally(n)
  slots: 0=n, 1=problem@catch, 2=<unwinding>, 3=<return value>
     4       0 LOAD_FAST            0 (n)
             1 LOAD_CONST           0 (0)
             2 GT
             3 JUMP_IF_NOT_TRUE     to 12 (if condition)
             4 LOAD_CONST           2 ('positive')
             5 STORE_FAST           3 (<return value>)
    11       6 LOAD_CONST           3 (<built-in print>)
             7 LOAD_CONST           4 ('always')
             8 CALL                 1
             9 POP
            10 LOAD_FAST            3 (<return value>)
     5      11 RETURN
       >>   12 LOAD_CONST           5 ('not positive')
     7      13 THROW
            14 JUMP                 to 26
     3 >>   15 STORE_FAST           1 (problem@catch)
            16 LOAD_CONST           6 ('caught: ')
     9      17 LOAD_FAST            1 (problem@catch)
            18 ADD
            19 STORE_FAST           3 (<return value>)
    11      20 LOAD_CONST           3 (<built-in print>)
            21 LOAD_CONST           4 ('always')
            22 CALL                 1
            23 POP
            24 LOAD_FAST            3 (<return value>)
     9      25 RETURN
    11 >>   26 LOAD_CONST           3 (<built-in print>)
            27 LOAD_CONST           4 ('always')
            28 CALL                 1
            29 POP
            30 JUMP                 to 37
       >>   31 STORE_FAST           2 (<unwinding>)
            32 LOAD_CONST           3 (<built-in print>)
            33 LOAD_CONST           4 ('always')
            34 CALL                 1
            35 POP
            36 RERAISE              2 (<unwinding>)
       >>   37 LOAD_CONST           7 (nothing)
            38 RETURN
  exception: 0-5 -> 15 (catch)
  exception: 10-13 -> 15 (catch)
  exception: 0-5 -> 31 (finally)
  exception: 10-19 -> 31 (finally)
  exception: 24-25 -> 31 (finally)

