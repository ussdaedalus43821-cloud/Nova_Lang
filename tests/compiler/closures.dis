code <module>
  slots: 0=i@loop, 1=<loop state>, 2=mine@block, 3=recall@block
     2       0 MAKE_FUNCTION        0 (<code outer>)
             1 STORE_GLOBAL         outer
    15       2 BUILD_LIST           0
             3 STORE_GLOBAL         counters
             4 LOAD_CONST           1 (1)
    16       5 LOOP_NUMBER          2 ("the start of a 'for' range")
             6 LOAD_CONST           3 (3)
             7 LOOP_NUMBER          4 ("the end of a 'for' range")
             8 RANGE_PREP           1 (<loop state>)
       >>    9 RANGE_NEXT           1 (<loop state>), done: to 22
            10 STORE_FAST           0 (i@loop)
            11 NEW_CELLS            2(mine@block)
    17      12 LOAD_FAST            0 (i@loop)
            13 STORE_CELL           2 (mine@block)
    18      14 MAKE_FUNCTION        6 (<code recall>)
            15 STORE_FAST           3 (recall@block)
    21      16 LOAD_CONST           7 (<built-in append>)
            17 LOAD_GLOBAL          counters
            18 LOAD_FAST            3 (recall@block)
            19 CALL                 2
            20 POP
            21 JUMP                 to 9
    24 >>   22 MAKE_FUNCTION        8 (<code shared_loop_variable>)
            23 DUP
            24 STORE_GLOBAL         shared_loop_variable
            25 RETURN

code outer(a)
  slots: 0=a, 1=b, 2=middle, 3=later
             0 NEW_CELLS            1(b) 3(later)
     3       1 LOAD_CELL            0 (a)
             2 LOAD_CONST           1 (1)
             3 ADD
             4 STORE_CELL           1 (b)
     4       5 MAKE_FUNCTION        2 (<code middle>)
             6 STORE_FAST           2 (middle)
             7 LOAD_CONST           3 (100)
    11       8 STORE_CELL           3 (later)
    12       9 LOAD_FAST            2 (middle)
            10 RETURN
            11 LOAD_CONST           4 (nothing)
            12 RETURN

code recall
  free:  0=mine
  closure (made from the enclosing frame): cell:2
    19       0 LOAD_CHAIN           0 (free:0 -> global:mine)
             1 RETURN
             2 LOAD_CONST           1 (nothing)
             3 RETURN

code shared_loop_variable
  slots: 0=fns, 1=k@loop, 2=<loop state>, 3=get@block
    25       0 BUILD_LIST           0
             1 STORE_FAST           0 (fns)
             2 LOAD_CONST           0 (1)
             3 LOAD_CONST           1 (2)
    26       4 BUILD_LIST           2
             5 ITER_PREP            2 (<loop state>), 1 name
             6 NEW_CELLS            1(k@loop)
       >>    7 ITER_NEXT            2 (<loop state>), done: to 17
             8 STORE_CELL           1 (k@loop)
    27       9 MAKE_FUNCTION        3 (<code get>)
            10 STORE_FAST           3 (get@block)
    30      11 LOAD_CONST           4 (<built-in append>)
            12 LOAD_FAST            0 (fns)
            13 LOAD_FAST            3 (get@block)
            14 CALL                 2
            15 POP
            16 JUMP                 to 7
    32 >>   17 LOAD_FAST            0 (fns)
            18 RETURN
            19 LOAD_CONST           5 (nothing)
            20 RETURN

code middle
  slots: 0=c, 1=inner
  free:  0=b, 1=a, 2=later
  closure (made from the enclosing frame): cell:1, cell:0, cell:3
             0 NEW_CELLS            0(c)
     5       1 LOAD_CHAIN           1 (free:0 -> global:b)
             2 LOAD_CONST           2 (1)
             3 ADD
             4 STORE_CELL           0 (c)
     6       5 MAKE_FUNCTION        3 (<code inner>)
             6 STORE_FAST           1 (inner)
     9       7 LOAD_FAST            1 (inner)
             8 RETURN
             9 LOAD_CONST           4 (nothing)
            10 RETURN

code get
  free:  0=k
  closure (made from the enclosing frame): cell:1
    28       0 LOAD_CHAIN           0 (free:0 -> global:k)
             1 RETURN
             2 LOAD_CONST           1 (nothing)
             3 RETURN

code inner
  free:  0=a, 1=b, 2=c, 3=later
  closure (made from the enclosing frame): free:1, free:0, cell:0, free:2
     7       0 LOAD_CHAIN           0 (free:0 -> global:a)
             1 LOAD_CHAIN           1 (free:1 -> global:b)
             2 ADD
             3 LOAD_CHAIN           2 (free:2 -> global:c)
             4 ADD
             5 LOAD_CHAIN           3 (free:3 -> global:later)
             6 ADD
             7 RETURN
             8 LOAD_CONST           4 (nothing)
             9 RETURN

