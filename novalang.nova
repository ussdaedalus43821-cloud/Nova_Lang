# novalang.nova - NovaLang's own Lexer, Parser and Interpreter, written in
# NovaLang itself. Part of the NovaLang v1.1.0 release.
#
# This file is a normal .nova program. Loaded and run by the host
# (novalang.py), it defines a second, self-hosted implementation of the
# language and then, if a target file was named on the command line, uses
# that implementation to lex, parse and run it - so the language written
# here is what actually executes the program, not novalang.py's own
# interpreter.
#
# Representation notes, since NovaLang has no classes:
#   - Tokens and AST nodes are dictionaries tagged with a "kind" field,
#     e.g. {kind: "NUMBER", value: 5, pos: 0}.
#   - A user-defined (target-program) function is also a tagged dictionary:
#     {kind: "function", params: [...], body: ..., closure: scope}. A
#     built-in is {kind: "builtin", name: "print"}. Everything else a
#     target program can hold - numbers, strings, booleans, lists,
#     dictionaries - is represented directly as the same NovaLang value,
#     since this interpreter and the program it runs share one host
#     runtime underneath.
#   - Lexer and parser state is an explicit dictionary threaded through
#     every helper function as a parameter (e.g. tokenize's `state`,
#     the parser's `p`), and mutated through bracket assignment
#     (state["index"] = ...), never through a bare name. Plain assignment
#     inside a function cannot reach an enclosing function's locals in
#     NovaLang - only a shared, mutated container can - so this is not a
#     style choice, it is how the language makes state threading explicit.

# ---------------------------------------------------------------------------
# Character classification
# ---------------------------------------------------------------------------

def is_digit(ch) {
    return ch >= "0" and ch <= "9"
}

def is_alpha(ch) {
    return (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"
}

def is_alnum(ch) {
    return is_digit(ch) or is_alpha(ch)
}

def is_space(ch) {
    return ch == " " or ch == "\t"
}

# ---------------------------------------------------------------------------
# Keywords
# ---------------------------------------------------------------------------

let KEYWORDS = {
    def: "DEF", return: "RETURN", if: "IF", else: "ELSE",
    true: "TRUE", false: "FALSE",
    while: "WHILE", for: "FOR", to: "TO", downto: "DOWNTO", step: "STEP",
    break: "BREAK", continue: "CONTINUE",
    and: "AND", or: "OR", not: "NOT",
    let: "LET", in: "IN",
    try: "TRY", catch: "CATCH", finally: "FINALLY", throw: "THROW",
    delete: "DELETE",
    import: "IMPORT", export: "EXPORT", as: "AS", with: "WITH"
}

let ESCAPES = {n: "\n", t: "\t", r: "\r", "0": "\0"}

# ---------------------------------------------------------------------------
# Lexer
# ---------------------------------------------------------------------------
#
# tokenize(source) returns a list of token dictionaries:
#   {kind: "NUMBER" | "STRING" | "FSTRING" | "IDENT" | <keyword or
#    punctuation kind> | "NEWLINE" | "EOF", value: <the token's payload>,
#    pos: <character offset, for error messages>}
#
# An FSTRING token's value is a list of parts: {kind: "text", value: "..."}
# or {kind: "expr", source: "...", pos: <offset>} - the parser turns each
# "expr" part into a real expression by lexing and parsing that fragment.

def lex_peek(state, ahead) {
    # "" means "past the end of the source" - a real character is always a
    # non-empty single-character string, so this is a safe, distinct sentinel.
    let spot = state["index"] + ahead
    if spot < len(state["source"]) {
        return state["source"][spot]
    }
    return ""
}

def lex_advance(state) {
    let ch = state["source"][state["index"]]
    state["index"] = state["index"] + 1
    return ch
}

def lex_error(message, pos) {
    throw("LexError@" + str(pos) + ": " + message)
}

def push_token(state, kind, value, pos) {
    append(state["tokens"], {kind: kind, value: value, pos: pos})
}

def lex_number(state) {
    let start = state["index"]
    let text = ""
    let seen_dot = false
    while state["index"] < len(state["source"]) {
        let ch = state["source"][state["index"]]
        if is_digit(ch) {
            text = text + ch
            state["index"] = state["index"] + 1
        } else if ch == "." and not seen_dot {
            seen_dot = true
            text = text + ch
            state["index"] = state["index"] + 1
        } else {
            break
        }
    }
    push_token(state, "NUMBER", num(text), start)
}

def lex_identifier(state) {
    let start = state["index"]
    let text = ""
    while state["index"] < len(state["source"]) and is_alnum(state["source"][state["index"]]) {
        text = text + state["source"][state["index"]]
        state["index"] = state["index"] + 1
    }
    if text in KEYWORDS {
        push_token(state, KEYWORDS[text], text, start)
    } else {
        push_token(state, "IDENT", text, start)
    }
}

def lex_escape(state, start) {
    let escape = lex_peek(state, 0)
    if escape == "" {
        lex_error("this string is never closed", start)
    }
    state["index"] = state["index"] + 1
    if escape == "\\" {
        return "\\"
    }
    if escape == "\"" {
        return "\""
    }
    if escape == "'" {
        return "'"
    }
    if escape in ESCAPES {
        return ESCAPES[escape]
    }
    lex_error("unknown escape '\\" + escape + "'", state["index"] - 1)
}

def lex_string(state) {
    let start = state["index"]
    let quote = lex_advance(state)
    let text = ""
    while true {
        let ch = lex_peek(state, 0)
        if ch == "" or ch == "\n" {
            lex_error("this string is never closed", start)
        }
        state["index"] = state["index"] + 1
        if ch == quote {
            push_token(state, "STRING", text, start)
            return
        }
        if ch == "\\" {
            text = text + lex_escape(state, start)
        } else {
            text = text + ch
        }
    }
}

def lex_fstring_placeholder(state, begin) {
    let depth = 1
    let inside = ""
    while true {
        let ch = lex_peek(state, 0)
        if ch == "" or ch == "\n" {
            lex_error("this f-string placeholder needs a closing '}'", begin)
        }
        if inside != "" {
            if ch == "\\" {
                state["index"] = state["index"] + 1
                if lex_peek(state, 0) == "" {
                    lex_error("this f-string placeholder needs a closing '}'", begin)
                }
                state["index"] = state["index"] + 1
                continue
            }
            if ch == inside {
                inside = ""
            }
            state["index"] = state["index"] + 1
            continue
        }
        if ch == "\"" or ch == "'" {
            inside = ch
        } else if ch == "{" {
            depth = depth + 1
        } else if ch == "}" {
            depth = depth - 1
            if depth == 0 {
                break
            }
        }
        state["index"] = state["index"] + 1
    }
    let source = state["source"][begin:state["index"]]
    state["index"] = state["index"] + 1
    if trim(source) == "" {
        lex_error("this f-string placeholder is empty", begin)
    }
    return {kind: "expr", source: source, pos: begin}
}

def lex_fstring(state) {
    let start = state["index"]
    state["index"] = state["index"] + 1
    let quote = lex_advance(state)
    let parts = []
    let text = ""
    while true {
        let ch = lex_peek(state, 0)
        if ch == "" or ch == "\n" {
            lex_error("this f-string is never closed", start)
        }
        if ch == quote {
            state["index"] = state["index"] + 1
            break
        }
        if ch == "\\" {
            state["index"] = state["index"] + 1
            text = text + lex_escape(state, start)
            continue
        }
        if (ch == "{" or ch == "}") and lex_peek(state, 1) == ch {
            state["index"] = state["index"] + 2
            text = text + ch
            continue
        }
        if ch == "}" {
            lex_error("a '}' inside an f-string must be written '}}'", state["index"])
        }
        if ch == "{" {
            if text != "" {
                append(parts, {kind: "text", value: text})
                text = ""
            }
            state["index"] = state["index"] + 1
            append(parts, lex_fstring_placeholder(state, state["index"]))
            continue
        }
        state["index"] = state["index"] + 1
        text = text + ch
    }
    if text != "" {
        append(parts, {kind: "text", value: text})
    }
    push_token(state, "FSTRING", parts, start)
}

def lex_two(state, text, kind) {
    if state["source"][state["index"]:state["index"] + 2] == text {
        state["index"] = state["index"] + 2
        push_token(state, kind, text, state["index"] - 2)
        return true
    }
    return false
}

let SINGLE_CHAR_KINDS = {
    "+": "PLUS", "-": "MINUS", "*": "STAR", "/": "SLASH",
    "(": "LPAREN", ")": "RPAREN", "{": "LBRACE", "}": "RBRACE",
    "[": "LBRACKET", "]": "RBRACKET", ",": "COMMA", ".": "DOT",
    ":": "COLON", "%": "PERCENT", "=": "EQUALS", "<": "LT", ">": "GT"
}

def tokenize(source) {
    let state = {source: source, index: 0, tokens: []}
    let length = len(source)
    while state["index"] < length {
        let ch = state["source"][state["index"]]
        let start = state["index"]

        if is_space(ch) {
            state["index"] = state["index"] + 1
        } else if ch == "\r" {
            state["index"] = state["index"] + 1
        } else if ch == "\n" or ch == ";" {
            state["index"] = state["index"] + 1
            push_token(state, "NEWLINE", ch, start)
        } else if ch == "#" {
            while state["index"] < length and state["source"][state["index"]] != "\n" {
                state["index"] = state["index"] + 1
            }
        } else if is_digit(ch) or (ch == "." and lex_peek(state, 1) != "" and is_digit(lex_peek(state, 1))) {
            lex_number(state)
        } else if ch == "f" and (lex_peek(state, 1) == "\"" or lex_peek(state, 1) == "'") {
            lex_fstring(state)
        } else if is_alpha(ch) {
            lex_identifier(state)
        } else if ch == "\"" or ch == "'" {
            lex_string(state)
        } else if lex_two(state, "//", "DSLASH") {
        } else if lex_two(state, "==", "EQ") {
        } else if lex_two(state, "!=", "NE") {
        } else if lex_two(state, "<=", "LE") {
        } else if lex_two(state, ">=", "GE") {
        } else if ch in SINGLE_CHAR_KINDS {
            state["index"] = state["index"] + 1
            push_token(state, SINGLE_CHAR_KINDS[ch], ch, start)
        } else if ch == "!" {
            lex_error("'!' on its own is not an operator - did you mean '!=' or 'not'?", start)
        } else {
            lex_error("unexpected character '" + ch + "'", start)
        }
    }
    append(state["tokens"], {kind: "EOF", value: "", pos: length})
    return state["tokens"]
}

# ---------------------------------------------------------------------------
# Parser
# ---------------------------------------------------------------------------
#
# Recursive descent over the same grammar novalang.py implements:
#
#   program     := (statement SEP)* EOF
#   statement   := funcdef | returnstmt | ifstmt | whilestmt | forstmt
#                | 'break' | 'continue' | letstmt | trystmt | throwstmt
#                | importstmt | exportstmt | delstmt | exprstmt
#   exprstmt    := expression ['=' exprstmt]
#   block       := '{' (statement SEP)* '}'
#   expression  := or_expr
#   or_expr     := and_expr ('or' and_expr)*
#   and_expr    := not_expr ('and' not_expr)*
#   not_expr    := 'not' not_expr | comparison
#   comparison  := additive [('<'|'>'|'<='|'>='|'=='|'!='|'in') additive]
#   additive    := term (('+'|'-') term)*
#   term        := unary (('*'|'/'|'%'|'//') unary)*
#   unary       := ('+'|'-') unary | call
#   call        := primary ('(' args ')' | '[' index_or_slice ']' | '.' NAME)*
#   primary     := NUMBER | STRING | FSTRING | 'true' | 'false' | IDENT
#                | '[' items ']' | '{' entries '}' | '(' expression ')'

let COMPARISON_KINDS = {EQ: true, NE: true, LT: true, GT: true, LE: true, GE: true, IN: true}
let BLOCK_KINDS = {If: true, While: true, For: true, ForIn: true, FunctionDef: true, Try: true}

def p_current(p) {
    return p["tokens"][p["index"]]
}

def p_peek(p, ahead) {
    let spot = p["index"] + ahead
    let last = len(p["tokens"]) - 1
    if spot > last {
        spot = last
    }
    return p["tokens"][spot]
}

def p_advance(p) {
    let token = p["tokens"][p["index"]]
    if token["kind"] != "EOF" {
        p["index"] = p["index"] + 1
    }
    return token
}

def p_describe(token) {
    if token["kind"] == "EOF" {
        return "the end of the input"
    }
    if token["kind"] == "NEWLINE" {
        return "the end of the line"
    }
    if token["kind"] == "STRING" {
        return "the string " + str(token["value"])
    }
    return str(token["value"])
}

def p_error(message, pos) {
    throw("ParseError@" + str(pos) + ": " + message)
}

def p_expect(p, kind, desc) {
    let token = p_current(p)
    if token["kind"] != kind {
        p_error("expected " + desc + ", found " + p_describe(token), token["pos"])
    }
    return p_advance(p)
}

def p_skip_newlines(p) {
    while p_current(p)["kind"] == "NEWLINE" {
        p_advance(p)
    }
}

def p_name_token(p, what) {
    return p_name_token_ext(p, what, false)
}

def p_name_token_ext(p, what, allow_string) {
    let token = p_current(p)
    if token["kind"] == "IDENT" {
        return p_advance(p)
    }
    if token["kind"] in KEYWORDS_BY_KIND {
        return p_advance(p)
    }
    if allow_string and token["kind"] == "STRING" {
        return p_advance(p)
    }
    p_error("expected " + what + ", found " + p_describe(token), token["pos"])
}

# Reverse index of every keyword's token kind, so a keyword can still be
# used as a dictionary key or a field name - "d.type" and "{in: 1}" are
# both legal, exactly like the host language.
def build_keyword_kinds() {
    let out = {}
    for word in keys(KEYWORDS) {
        out[KEYWORDS[word]] = true
    }
    return out
}
let KEYWORDS_BY_KIND = build_keyword_kinds()

def stmt_self_terminates(node) {
    let target = node
    if node["kind"] == "Export" {
        target = node["inner"]
    }
    return target["kind"] in BLOCK_KINDS
}

def p_end_statement(p, closers) {
    if stmt_self_terminates(p["last_statement"]) {
        p_skip_newlines(p)
        return
    }
    let token = p_current(p)
    if token["kind"] in closers {
        return
    }
    if token["kind"] == "NEWLINE" {
        p_skip_newlines(p)
        return
    }
    p_error("expected a new line between statements, found " + p_describe(token), token["pos"])
}

def p_optional_keyword(p, kind) {
    let rewind = p["index"]
    p_skip_newlines(p)
    if p_current(p)["kind"] == kind {
        p_advance(p)
        return true
    }
    p["index"] = rewind
    return false
}

def parse_program(source) {
    let p = {tokens: tokenize(source), index: 0, last_statement: {kind: "Program"}}
    let statements = []
    p_skip_newlines(p)
    while p_current(p)["kind"] != "EOF" {
        let statement = parse_statement(p)
        append(statements, statement)
        p["last_statement"] = statement
        p_end_statement(p, {EOF: true})
        p_skip_newlines(p)
    }
    return {kind: "Program", statements: statements}
}

def parse_block(p) {
    p_skip_newlines(p)
    let opening = p_expect(p, "LBRACE", "a '{' to open the block")
    let statements = []
    p_skip_newlines(p)
    while p_current(p)["kind"] != "RBRACE" and p_current(p)["kind"] != "EOF" {
        let statement = parse_statement(p)
        append(statements, statement)
        p["last_statement"] = statement
        p_end_statement(p, {RBRACE: true, EOF: true})
        p_skip_newlines(p)
    }
    if p_current(p)["kind"] != "RBRACE" {
        p_error("this block is never closed with '}'", opening["pos"])
    }
    p_advance(p)
    return {kind: "Block", statements: statements, pos: opening["pos"]}
}

def parse_statement(p) {
    let token = p_current(p)
    if token["kind"] == "DEF" {
        return parse_function_def(p)
    }
    if token["kind"] == "RETURN" {
        return parse_return(p)
    }
    if token["kind"] == "IF" {
        return parse_if(p)
    }
    if token["kind"] == "WHILE" {
        return parse_while(p)
    }
    if token["kind"] == "FOR" {
        return parse_for(p)
    }
    if token["kind"] == "BREAK" {
        p_advance(p)
        return {kind: "Break", pos: token["pos"]}
    }
    if token["kind"] == "CONTINUE" {
        p_advance(p)
        return {kind: "Continue", pos: token["pos"]}
    }
    if token["kind"] == "LET" {
        return parse_let(p)
    }
    if token["kind"] == "TRY" {
        return parse_try(p)
    }
    if token["kind"] == "THROW" {
        return parse_throw(p)
    }
    if token["kind"] == "DELETE" {
        return parse_delete(p)
    }
    if token["kind"] == "IMPORT" {
        return parse_import(p)
    }
    if token["kind"] == "EXPORT" {
        return parse_export(p)
    }
    return parse_expression_statement(p)
}

def parse_function_def(p) {
    let keyword = p_advance(p)
    let name = p_expect(p, "IDENT", "a function name after 'def'")
    p_expect(p, "LPAREN", "a '(' after the function name")
    let params = []
    if p_current(p)["kind"] != "RPAREN" {
        while true {
            let param = p_expect(p, "IDENT", "a parameter name")
            append(params, param["value"])
            if p_current(p)["kind"] != "COMMA" {
                break
            }
            p_advance(p)
        }
    }
    p_expect(p, "RPAREN", "a ')' to close the parameter list")
    let body = parse_block(p)
    return {kind: "FunctionDef", name: name["value"], params: params, body: body, pos: keyword["pos"]}
}

def parse_return(p) {
    let keyword = p_advance(p)
    let stop = {NEWLINE: true, RBRACE: true, EOF: true}
    if p_current(p)["kind"] in stop {
        return {kind: "Return", has_value: false, pos: keyword["pos"]}
    }
    return {kind: "Return", has_value: true, value: parse_expression(p), pos: keyword["pos"]}
}

def parse_if(p) {
    let keyword = p_advance(p)
    let condition = parse_expression(p)
    let then_block = parse_block(p)
    if p_optional_keyword(p, "ELSE") {
        let else_block = {kind: "Block", statements: []}
        if p_current(p)["kind"] == "IF" {
            else_block = parse_if(p)
        } else {
            else_block = parse_block(p)
        }
        return {kind: "If", condition: condition, then_block: then_block, has_else: true, else_block: else_block, pos: keyword["pos"]}
    }
    return {kind: "If", condition: condition, then_block: then_block, has_else: false, pos: keyword["pos"]}
}

def parse_while(p) {
    let keyword = p_advance(p)
    let condition = parse_expression(p)
    let body = parse_block(p)
    if p_optional_keyword(p, "ELSE") {
        return {kind: "While", condition: condition, body: body, has_else: true, else_block: parse_block(p), pos: keyword["pos"]}
    }
    return {kind: "While", condition: condition, body: body, has_else: false, pos: keyword["pos"]}
}

def parse_for(p) {
    let keyword = p_advance(p)
    let name = p_expect(p, "IDENT", "a loop variable after 'for'")

    if p_current(p)["kind"] == "COMMA" {
        p_advance(p)
        let second = p_expect(p, "IDENT", "a second loop variable after the comma")
        p_expect(p, "IN", "'in' after the loop variables")
        let iterable = parse_expression(p)
        let body = parse_block(p)
        if p_optional_keyword(p, "ELSE") {
            return {kind: "ForIn", name: name["value"], has_second: true, second_name: second["value"], iterable: iterable, body: body, has_else: true, else_block: parse_block(p), pos: keyword["pos"]}
        }
        return {kind: "ForIn", name: name["value"], has_second: true, second_name: second["value"], iterable: iterable, body: body, has_else: false, pos: keyword["pos"]}
    }

    if p_current(p)["kind"] == "IN" {
        p_advance(p)
        let iterable = parse_expression(p)
        let body = parse_block(p)
        if p_optional_keyword(p, "ELSE") {
            return {kind: "ForIn", name: name["value"], has_second: false, iterable: iterable, body: body, has_else: true, else_block: parse_block(p), pos: keyword["pos"]}
        }
        return {kind: "ForIn", name: name["value"], has_second: false, iterable: iterable, body: body, has_else: false, pos: keyword["pos"]}
    }

    p_expect(p, "EQUALS", "a '=' or 'in' after the loop variable")
    let start = parse_expression(p)
    let to_kinds = {TO: true, DOWNTO: true}
    if not (p_current(p)["kind"] in to_kinds) {
        p_error("expected 'to' or 'downto', found " + p_describe(p_current(p)), p_current(p)["pos"])
    }
    let descending = p_advance(p)["kind"] == "DOWNTO"
    let end = parse_expression(p)
    let step_node = {kind: "Number", value: 1}
    if p_current(p)["kind"] == "STEP" {
        p_advance(p)
        step_node = parse_expression(p)
    }
    let body = parse_block(p)
    if p_optional_keyword(p, "ELSE") {
        return {kind: "For", name: name["value"], start: start, end: end, step: step_node, descending: descending, body: body, has_else: true, else_block: parse_block(p), pos: keyword["pos"]}
    }
    return {kind: "For", name: name["value"], start: start, end: end, step: step_node, descending: descending, body: body, has_else: false, pos: keyword["pos"]}
}

def parse_let(p) {
    let keyword = p_advance(p)
    let name = p_expect(p, "IDENT", "a name after 'let'")
    p_expect(p, "EQUALS", "a '=' after the name in a 'let'")
    return {kind: "Let", name: name["value"], value: parse_expression_statement(p), pos: keyword["pos"]}
}

def parse_try(p) {
    let keyword = p_advance(p)
    let body = parse_block(p)
    let has_catch = false
    let catch_has_name = false
    let catch_name = ""
    let catch_block = {kind: "Block", statements: []}
    if p_optional_keyword(p, "CATCH") {
        has_catch = true
        if p_current(p)["kind"] == "IDENT" {
            catch_has_name = true
            catch_name = p_advance(p)["value"]
        }
        catch_block = parse_block(p)
    }
    let has_finally = false
    let finally_block = {kind: "Block", statements: []}
    if p_optional_keyword(p, "FINALLY") {
        has_finally = true
        finally_block = parse_block(p)
    }
    if not has_catch and not has_finally {
        p_error("a 'try' needs a 'catch', a 'finally', or both", keyword["pos"])
    }
    return {kind: "Try", body: body, has_catch: has_catch, catch_has_name: catch_has_name,
            catch_name: catch_name, catch_block: catch_block, has_finally: has_finally,
            finally_block: finally_block, pos: keyword["pos"]}
}

def parse_throw(p) {
    let keyword = p_advance(p)
    let stop = {NEWLINE: true, RBRACE: true, EOF: true}
    if p_current(p)["kind"] in stop {
        p_error("throw needs a message to throw", keyword["pos"])
    }
    return {kind: "Throw", value: parse_expression(p), pos: keyword["pos"]}
}

def parse_delete(p) {
    let keyword = p_advance(p)
    if p_current(p)["kind"] == "LPAREN" {
        p_advance(p)
        let path = parse_expression(p)
        p_expect(p, "RPAREN", "a ')' after the file name")
        return {kind: "DeleteFile", path: path, pos: keyword["pos"]}
    }
    let target = parse_expression(p)
    if target["kind"] == "Member" {
        return {kind: "Delete", target: target["target"], key: {kind: "String", value: target["name"]}, pos: keyword["pos"]}
    }
    if target["kind"] == "Index" {
        return {kind: "Delete", target: target["target"], key: target["index"], pos: keyword["pos"]}
    }
    p_error("delete needs a dictionary entry, as in 'delete d.key' or 'delete d[\"key\"]', or a file, as in 'delete(\"temp.txt\")'", keyword["pos"])
}

def parse_import(p) {
    let keyword = p_advance(p)
    let path = p_expect(p, "STRING", "a quoted module path after 'import'")
    if p_current(p)["kind"] == "AS" {
        p_advance(p)
        let alias = p_expect(p, "IDENT", "a name after 'as'")
        return {kind: "Import", path: path["value"], mode: "as", alias: alias["value"], pos: keyword["pos"]}
    }
    if p_current(p)["kind"] == "WITH" {
        p_advance(p)
        let names = []
        while true {
            let name = p_expect(p, "IDENT", "a name to import")
            append(names, name["value"])
            if p_current(p)["kind"] != "COMMA" {
                break
            }
            p_advance(p)
        }
        return {kind: "Import", path: path["value"], mode: "with", names: names, pos: keyword["pos"]}
    }
    return {kind: "Import", path: path["value"], mode: "plain", pos: keyword["pos"]}
}

def parse_export(p) {
    let keyword = p_advance(p)
    let inner = {kind: "Let", name: "", value: {kind: "Boolean", value: false}}
    if p_current(p)["kind"] == "DEF" {
        inner = parse_function_def(p)
    } else if p_current(p)["kind"] == "LET" {
        inner = parse_let(p)
    } else {
        p_error("'export' must be followed by 'def' or 'let', found " + p_describe(p_current(p)), keyword["pos"])
    }
    return {kind: "Export", inner: inner, pos: keyword["pos"]}
}

def parse_expression_statement(p) {
    let node = parse_expression(p)
    if p_current(p)["kind"] != "EQUALS" {
        return node
    }
    let equals = p_advance(p)
    let value = parse_expression_statement(p)
    if node["kind"] == "Var" {
        return {kind: "Assign", name: node["name"], value: value, pos: node["pos"]}
    }
    if node["kind"] == "Index" {
        return {kind: "IndexAssign", target: node["target"], index: node["index"], value: value, pos: node["pos"]}
    }
    if node["kind"] == "Member" {
        return {kind: "MemberAssign", target: node["target"], name: node["name"], value: value, pos: node["pos"]}
    }
    p_error("the left side of '=' must be a variable, a list item or a field", equals["pos"])
}

def parse_expression(p) {
    return parse_or(p)
}

def parse_or(p) {
    let node = parse_and(p)
    while p_current(p)["kind"] == "OR" {
        let op = p_advance(p)
        node = {kind: "Logical", left: node, op: "or", right: parse_and(p), pos: op["pos"]}
    }
    return node
}

def parse_and(p) {
    let node = parse_not(p)
    while p_current(p)["kind"] == "AND" {
        let op = p_advance(p)
        node = {kind: "Logical", left: node, op: "and", right: parse_not(p), pos: op["pos"]}
    }
    return node
}

def parse_not(p) {
    if p_current(p)["kind"] == "NOT" {
        let op = p_advance(p)
        return {kind: "Not", operand: parse_not(p), pos: op["pos"]}
    }
    return parse_comparison(p)
}

def parse_comparison(p) {
    let node = parse_additive(p)
    if p_current(p)["kind"] in COMPARISON_KINDS {
        let op = p_advance(p)
        let right = parse_additive(p)
        node = {kind: "Compare", left: node, op: op["value"], right: right, pos: op["pos"]}
        if p_current(p)["kind"] in COMPARISON_KINDS {
            p_error("chained comparisons like 'a < b < c' are not supported yet", p_current(p)["pos"])
        }
    }
    return node
}

def parse_additive(p) {
    let node = parse_term(p)
    let kinds = {PLUS: true, MINUS: true}
    while p_current(p)["kind"] in kinds {
        let op = p_advance(p)
        node = {kind: "BinOp", left: node, op: op["value"], right: parse_term(p), pos: op["pos"]}
    }
    return node
}

def parse_term(p) {
    let node = parse_unary(p)
    let kinds = {STAR: true, SLASH: true, PERCENT: true, DSLASH: true}
    while p_current(p)["kind"] in kinds {
        let op = p_advance(p)
        node = {kind: "BinOp", left: node, op: op["value"], right: parse_unary(p), pos: op["pos"]}
    }
    return node
}

def parse_unary(p) {
    let kinds = {PLUS: true, MINUS: true}
    if p_current(p)["kind"] in kinds {
        let op = p_advance(p)
        return {kind: "Unary", op: op["value"], operand: parse_unary(p), pos: op["pos"]}
    }
    return parse_call(p)
}

def parse_call(p) {
    let node = parse_primary(p)
    while true {
        if p_current(p)["kind"] == "LPAREN" {
            let paren = p_advance(p)
            let call_args = []
            if p_current(p)["kind"] != "RPAREN" {
                while true {
                    append(call_args, parse_expression(p))
                    if p_current(p)["kind"] != "COMMA" {
                        break
                    }
                    p_advance(p)
                }
            }
            p_expect(p, "RPAREN", "a ')' to close the argument list")
            node = {kind: "Call", callee: node, call_args: call_args, pos: paren["pos"]}
        } else if p_current(p)["kind"] == "LBRACKET" {
            let bracket = p_advance(p)
            node = parse_index_or_slice(p, node, bracket)
        } else if p_current(p)["kind"] == "DOT" {
            let dot = p_advance(p)
            let name = p_name_token(p, "a field name after '.'")
            node = {kind: "Member", target: node, name: name["value"], pos: dot["pos"]}
        } else {
            return node
        }
    }
}

def parse_index_or_slice(p, target, bracket) {
    let has_start = false
    let start = {kind: "Number", value: 0}
    if p_current(p)["kind"] != "COLON" and p_current(p)["kind"] != "RBRACKET" {
        has_start = true
        start = parse_expression(p)
    }
    if p_current(p)["kind"] == "COLON" {
        p_advance(p)
        let has_end = false
        let end = {kind: "Number", value: 0}
        if p_current(p)["kind"] != "RBRACKET" {
            has_end = true
            end = parse_expression(p)
        }
        p_expect(p, "RBRACKET", "a ']' to close the slice")
        return {kind: "Slice", target: target, has_start: has_start, start: start,
                has_end: has_end, end: end, pos: bracket["pos"]}
    }
    if not has_start {
        p_error("an index cannot be empty", bracket["pos"])
    }
    p_expect(p, "RBRACKET", "a ']' to close the index")
    return {kind: "Index", target: target, index: start, pos: bracket["pos"]}
}

def parse_dict_literal(p, brace) {
    let entries = []
    let seen = {}
    p_skip_newlines(p)
    if p_current(p)["kind"] != "RBRACE" {
        while true {
            let key = p_name_token_ext(p, "a key name", true)
            if key["value"] in seen {
                p_error("the key '" + key["value"] + "' appears twice in this dictionary", key["pos"])
            }
            seen[key["value"]] = true
            p_expect(p, "COLON", "a ':' after the key")
            append(entries, {key: key["value"], value: parse_expression(p)})
            p_skip_newlines(p)
            if p_current(p)["kind"] != "COMMA" {
                break
            }
            p_advance(p)
            p_skip_newlines(p)
        }
    }
    p_expect(p, "RBRACE", "a '}' to close the dictionary")
    return {kind: "Dict", entries: entries, pos: brace["pos"]}
}

def parse_fstring_node(token) {
    let parts = []
    for part in token["value"] {
        if part["kind"] == "text" {
            append(parts, {kind: "String", value: part["value"]})
        } else {
            let inner = {tokens: tokenize(part["source"]), index: 0, last_statement: {kind: "Program"}}
            let expr = parse_expression(inner)
            if p_current(inner)["kind"] != "EOF" {
                p_error("unexpected " + p_describe(p_current(inner)) + " inside this f-string", part["pos"])
            }
            append(parts, expr)
        }
    }
    return {kind: "FString", parts: parts, pos: token["pos"]}
}

def parse_primary(p) {
    let token = p_current(p)
    if token["kind"] == "NUMBER" {
        p_advance(p)
        return {kind: "Number", value: token["value"]}
    }
    if token["kind"] == "STRING" {
        p_advance(p)
        return {kind: "String", value: token["value"]}
    }
    if token["kind"] == "FSTRING" {
        p_advance(p)
        return parse_fstring_node(token)
    }
    if token["kind"] == "TRUE" {
        p_advance(p)
        return {kind: "Boolean", value: true}
    }
    if token["kind"] == "FALSE" {
        p_advance(p)
        return {kind: "Boolean", value: false}
    }
    if token["kind"] == "IDENT" {
        p_advance(p)
        return {kind: "Var", name: token["value"], pos: token["pos"]}
    }
    if token["kind"] == "LBRACKET" {
        p_advance(p)
        let items = []
        p_skip_newlines(p)
        if p_current(p)["kind"] != "RBRACKET" {
            while true {
                append(items, parse_expression(p))
                p_skip_newlines(p)
                if p_current(p)["kind"] != "COMMA" {
                    break
                }
                p_advance(p)
                p_skip_newlines(p)
            }
        }
        p_expect(p, "RBRACKET", "a ']' to close the list")
        return {kind: "List", items: items, pos: token["pos"]}
    }
    if token["kind"] == "LBRACE" {
        p_advance(p)
        return parse_dict_literal(p, token)
    }
    if token["kind"] == "LPAREN" {
        p_advance(p)
        let node = parse_expression(p)
        p_expect(p, "RPAREN", "a closing ')'")
        return node
    }
    let enders = {EOF: true, NEWLINE: true}
    if token["kind"] in enders {
        p_error("the expression ends too early", token["pos"])
    }
    p_error("unexpected " + p_describe(token), token["pos"])
}

# ---------------------------------------------------------------------------
# Interpreter
# ---------------------------------------------------------------------------
#
# Values: numbers, strings, booleans, lists and dictionaries are the same
# NovaLang values the host itself uses - this interpreter and the program
# it runs share one runtime, so `left + right` on two target numbers is
# simply the host's own '+'. Only two things get a tagged-dictionary
# representation of their own, because this interpreter must control how
# they behave: a user-defined function is {kind: "function", params:,
# body:, closure:}, and a built-in is {kind: "builtin", name:}.
#
# Scopes are {vars: {}, parent: <scope>, barrier: <bool>, is_root: <bool>},
# mirroring novalang.py's own Environment: lookups walk the whole parent
# chain, assignment walks outward only as far as the nearest barrier
# (a function call, or the global scope).
#
# Statement execution returns a "signal" dictionary - {kind: "normal"},
# {kind: "return", value:}, {kind: "break"} or {kind: "continue"} - checked
# explicitly by every block, loop and function call. Runtime errors instead
# use the host's own throw/catch, which is what an in-language `try` block
# below is built on: it costs nothing extra, since a message is exactly
# what a target `catch e` needs to bind.

def make_nothing() {
    return
}

def make_env(parent, barrier, is_root) {
    return {vars: {}, parent: parent, barrier: barrier, is_root: is_root}
}

# PI, E and json are predefined globals, not reserved builtin names - an
# ordinary `let PI = 3` shadows them in its own scope, matching the host.
def define_stdlib_globals(scope) {
    scope["vars"]["PI"] = 3.141592653589793
    scope["vars"]["E"] = 2.718281828459045
    scope["vars"]["json"] = {
        dumps: {kind: "builtin", name: "json_dumps"},
        loads: {kind: "builtin", name: "json_loads"},
        pretty: {kind: "builtin", name: "json_pretty"}
    }
    # Stage 12: python.* delegates straight to the host's real python.*
    # (see call_builtin below) - this interpreter is itself NovaLang code
    # running under that same host, so its own `python` global already IS
    # the real, host-bound namespace with the real registry behind it.
    scope["vars"]["python"] = {
        "import": {kind: "builtin", name: "python_import"},
        call: {kind: "builtin", name: "python_call"},
        get: {kind: "builtin", name: "python_get"},
        set: {kind: "builtin", name: "python_set"}
    }
}

def env_has(scope, name) {
    let scope = scope
    while true {
        if name in scope["vars"] {
            return true
        }
        if scope["is_root"] {
            return false
        }
        scope = scope["parent"]
    }
}

def env_get(scope, name) {
    let scope = scope
    while true {
        if name in scope["vars"] {
            return scope["vars"][name]
        }
        if scope["is_root"] {
            return make_nothing()
        }
        scope = scope["parent"]
    }
}

def env_define(scope, name, value) {
    scope["vars"][name] = value
}

def env_assign(scope, name, value) {
    let scope = scope
    while true {
        if name in scope["vars"] {
            scope["vars"][name] = value
            return
        }
        if scope["barrier"] {
            break
        }
        scope = scope["parent"]
    }
    scope["vars"][name] = value
}

def sig_normal() {
    return {kind: "normal"}
}

def sig_return(value) {
    return {kind: "return", value: value}
}

def sig_break() {
    return {kind: "break"}
}

def sig_continue() {
    return {kind: "continue"}
}

def raise_error(message, pos) {
    throw(message)
}

# ---- built-ins --------------------------------------------------------

let BUILTIN_NAMES = {
    print: true, len: true, append: true, pop: true, range: true,
    upper: true, lower: true, trim: true, split: true, join: true,
    str: true, num: true, type: true, keys: true, values: true,
    read: true, write: true, exists: true, listdir: true, input: true,

    "time": true, sleep: true, now: true, format_time: true,
    "random": true, randint: true, choice: true, shuffle: true,
    "abs": true, "round": true, floor: true, ceil: true, sqrt: true,
    "pow": true, sin: true, cos: true, tan: true, ln: true, log10: true,
    min: true, max: true, sum: true,
    env: true, exit: true, args: true, platform: true,
    cwd: true, mkdir: true, remove: true, rename: true, copy: true,
    regex: true, replace_all: true, split_lines: true,
    pad: true, pad_left: true, reverse: true, sorted: true,
    "assert": true, log: true,
    map: true, filter: true, reduce: true
}

def is_target_function(v) {
    return type(v) == "dict" and "kind" in v and (v["kind"] == "function" or v["kind"] == "builtin")
}

def target_str(v) {
    if type(v) == "dict" and "kind" in v {
        if v["kind"] == "function" {
            return "<function " + v["name"] + "(" + join(v["params"], ", ") + ")>"
        }
        if v["kind"] == "builtin" {
            return "<built-in function " + v["name"] + ">"
        }
    }
    return str(v)
}

def target_type(v) {
    if is_target_function(v) {
        return "function"
    }
    return type(v)
}

# min/max/sum accept either several numbers or one list of numbers; this
# normalizes call_args to a single list either way, then always calls the
# host with one list argument, so its own len(args)==1-and-a-list check
# (numbers_from_args in novalang.py) reads it the same way for both shapes.
def numbers_from_call_args(call_args) {
    if len(call_args) == 1 and type(call_args[0]) == "list" {
        return call_args[0]
    }
    return call_args
}

def call_builtin(name, call_args, pos) {
    if name == "print" {
        let text = ""
        let i = 0
        while i < len(call_args) {
            if i > 0 {
                text = text + " "
            }
            text = text + target_str(call_args[i])
            i = i + 1
        }
        print(text)
        return make_nothing()
    }
    if name == "len" {
        return len(call_args[0])
    }
    if name == "append" {
        return append(call_args[0], call_args[1])
    }
    if name == "pop" {
        if len(call_args) == 1 {
            return pop(call_args[0])
        }
        return pop(call_args[0], call_args[1])
    }
    if name == "range" {
        if len(call_args) == 1 {
            return range(call_args[0])
        }
        if len(call_args) == 2 {
            return range(call_args[0], call_args[1])
        }
        return range(call_args[0], call_args[1], call_args[2])
    }
    if name == "upper" {
        return upper(call_args[0])
    }
    if name == "lower" {
        return lower(call_args[0])
    }
    if name == "trim" {
        return trim(call_args[0])
    }
    if name == "split" {
        if len(call_args) == 1 {
            return split(call_args[0])
        }
        return split(call_args[0], call_args[1])
    }
    if name == "join" {
        return join(call_args[0], call_args[1])
    }
    if name == "str" {
        return target_str(call_args[0])
    }
    if name == "num" {
        return num(call_args[0])
    }
    if name == "type" {
        return target_type(call_args[0])
    }
    if name == "keys" {
        return keys(call_args[0])
    }
    if name == "values" {
        return values(call_args[0])
    }
    if name == "read" {
        return read(call_args[0])
    }
    if name == "write" {
        return write(call_args[0], call_args[1])
    }
    if name == "exists" {
        return exists(call_args[0])
    }
    if name == "listdir" {
        return listdir(call_args[0])
    }
    if name == "input" {
        if len(call_args) == 0 {
            return input()
        }
        return input(call_args[0])
    }
    if name == "time" {
        return time()
    }
    if name == "sleep" {
        return sleep(call_args[0])
    }
    if name == "now" {
        return now()
    }
    if name == "format_time" {
        return format_time(call_args[0], call_args[1])
    }
    if name == "random" {
        return random()
    }
    if name == "randint" {
        return randint(call_args[0], call_args[1])
    }
    if name == "choice" {
        return choice(call_args[0])
    }
    if name == "shuffle" {
        return shuffle(call_args[0])
    }
    if name == "abs" {
        return abs(call_args[0])
    }
    if name == "round" {
        if len(call_args) == 1 {
            return round(call_args[0])
        }
        return round(call_args[0], call_args[1])
    }
    if name == "floor" {
        return floor(call_args[0])
    }
    if name == "ceil" {
        return ceil(call_args[0])
    }
    if name == "sqrt" {
        return sqrt(call_args[0])
    }
    if name == "pow" {
        return pow(call_args[0], call_args[1])
    }
    if name == "sin" {
        return sin(call_args[0])
    }
    if name == "cos" {
        return cos(call_args[0])
    }
    if name == "tan" {
        return tan(call_args[0])
    }
    if name == "ln" {
        return ln(call_args[0])
    }
    if name == "log10" {
        return log10(call_args[0])
    }
    if name == "min" {
        return min(numbers_from_call_args(call_args))
    }
    if name == "max" {
        return max(numbers_from_call_args(call_args))
    }
    if name == "sum" {
        return sum(numbers_from_call_args(call_args))
    }
    if name == "env" {
        return env(call_args[0])
    }
    if name == "exit" {
        if len(call_args) == 0 {
            return exit()
        }
        return exit(call_args[0])
    }
    if name == "args" {
        return args()
    }
    if name == "platform" {
        return platform()
    }
    if name == "json_dumps" {
        return json.dumps(call_args[0])
    }
    if name == "json_loads" {
        return json.loads(call_args[0])
    }
    if name == "json_pretty" {
        return json.pretty(call_args[0])
    }
    if name == "python_import" {
        return python.import(call_args[0])
    }
    if name == "python_get" {
        return python.get(call_args[0])
    }
    if name == "python_set" {
        return python.set(call_args[0], call_args[1])
    }
    if name == "python_call" {
        # python.call(name, ...) is variadic on the host too; a handful of
        # explicit arities covers realistic embedding calls without needing
        # a general argument-spread NovaLang does not have syntax for.
        if len(call_args) == 1 {
            return python.call(call_args[0])
        }
        if len(call_args) == 2 {
            return python.call(call_args[0], call_args[1])
        }
        if len(call_args) == 3 {
            return python.call(call_args[0], call_args[1], call_args[2])
        }
        if len(call_args) == 4 {
            return python.call(call_args[0], call_args[1], call_args[2], call_args[3])
        }
        if len(call_args) == 5 {
            return python.call(call_args[0], call_args[1], call_args[2], call_args[3], call_args[4])
        }
        return python.call(call_args[0], call_args[1], call_args[2], call_args[3], call_args[4], call_args[5])
    }
    if name == "cwd" {
        return cwd()
    }
    if name == "mkdir" {
        return mkdir(call_args[0])
    }
    if name == "remove" {
        return remove(call_args[0])
    }
    if name == "rename" {
        return rename(call_args[0], call_args[1])
    }
    if name == "copy" {
        return copy(call_args[0], call_args[1])
    }
    if name == "regex" {
        return regex(call_args[0], call_args[1])
    }
    if name == "replace_all" {
        return replace_all(call_args[0], call_args[1], call_args[2])
    }
    if name == "split_lines" {
        return split_lines(call_args[0])
    }
    if name == "pad" {
        return pad(call_args[0], call_args[1])
    }
    if name == "pad_left" {
        return pad_left(call_args[0], call_args[1])
    }
    if name == "reverse" {
        return reverse(call_args[0])
    }
    if name == "sorted" {
        if len(call_args) == 1 {
            return sorted(call_args[0])
        }
        return sorted(call_args[0], call_args[1])
    }
    if name == "assert" {
        if len(call_args) == 1 {
            return assert(call_args[0])
        }
        return assert(call_args[0], call_args[1])
    }
    if name == "log" {
        return log(call_args[0])
    }
    if name == "map" {
        return target_map(call_args[0], call_args[1], pos)
    }
    if name == "filter" {
        return target_filter(call_args[0], call_args[1], pos)
    }
    if name == "reduce" {
        return target_reduce(call_args, pos)
    }

    raise_error("unknown built-in '" + name + "'", pos)
}

# map/filter/reduce call back into a target function value of their own,
# via call_target_value - the same dispatcher a Call node uses. Nothing
# extra was needed to make this possible: the self-hosted interpreter
# already has everything it takes to invoke a function value, unlike the
# host, which had to grow a new needs_interpreter mechanism for this.

def target_map(fn, items, pos) {
    let out = []
    for item in items {
        append(out, call_target_value(fn, [item], pos))
    }
    return out
}

def target_filter(fn, items, pos) {
    let out = []
    for item in items {
        let keep = call_target_value(fn, [item], pos)
        if type(keep) != "boolean" {
            raise_error("filter()'s function must return true or false", pos)
        }
        if keep {
            append(out, item)
        }
    }
    return out
}

def target_reduce(call_args, pos) {
    let fn = call_args[0]
    let items = call_args[1]
    let accumulator = 0
    let rest = items
    if len(call_args) >= 3 {
        accumulator = call_args[2]
        rest = items
    } else {
        if len(items) == 0 {
            raise_error("reduce() needs a non-empty list, or an initial value as a third argument", pos)
        }
        accumulator = items[0]
        rest = items[1:]
    }
    for item in rest {
        accumulator = call_target_value(fn, [accumulator, item], pos)
    }
    return accumulator
}

# ---- calling a target function -----------------------------------------

let CALL_DEPTH = {n: 0}
let MAX_TARGET_DEPTH = 60

def call_function(fn, call_args, pos) {
    if len(call_args) != len(fn["params"]) {
        raise_error(fn["name"] + "() expects " + str(len(fn["params"])) + " argument(s) but got " + str(len(call_args)), pos)
    }

    CALL_DEPTH["n"] = CALL_DEPTH["n"] + 1
    if CALL_DEPTH["n"] > MAX_TARGET_DEPTH {
        CALL_DEPTH["n"] = CALL_DEPTH["n"] - 1
        raise_error("call depth of " + str(MAX_TARGET_DEPTH) + " exceeded - is the recursion missing a base case?", pos)
    }

    let frame = make_env(fn["closure"], true, false)
    let i = 0
    while i < len(fn["params"]) {
        frame["vars"][fn["params"][i]] = call_args[i]
        i = i + 1
    }

    let result = sig_normal()
    try {
        result = exec_block(fn["body"]["statements"], frame)
    } finally {
        CALL_DEPTH["n"] = CALL_DEPTH["n"] - 1
    }

    if result["kind"] == "return" {
        return result["value"]
    }
    if result["kind"] == "break" or result["kind"] == "continue" {
        raise_error("'" + result["kind"] + "' is not inside a loop in " + fn["name"] + "()", pos)
    }
    return make_nothing()
}

def eval_call(node, scope) {
    let callee = eval_expr(node["callee"], scope)
    let call_args = []
    for arg_node in node["call_args"] {
        append(call_args, eval_expr(arg_node, scope))
    }
    return call_target_value(callee, call_args, node["pos"])
}

# Call an already-evaluated callee with already-evaluated call_args - shared by
# ordinary Call-node evaluation and by map/filter/reduce, which call back
# into a target function value of their own (Stage 11).
def call_target_value(callee, call_args, pos) {
    if not is_target_function(callee) {
        raise_error(target_type(callee) + " is not a function, so it cannot be called", pos)
    }
    if callee["kind"] == "builtin" {
        return call_builtin(callee["name"], call_args, pos)
    }
    return call_function(callee, call_args, pos)
}

# ---- expressions --------------------------------------------------------

def eval_var(node, scope) {
    if env_has(scope, node["name"]) {
        return env_get(scope, node["name"])
    }
    if node["name"] in BUILTIN_NAMES {
        return {kind: "builtin", name: node["name"]}
    }
    raise_error("undefined name '" + node["name"] + "'", node["pos"])
}

def eval_unary(node, scope) {
    let value = eval_expr(node["operand"], scope)
    if node["op"] == "+" {
        return +value
    }
    return -value
}

def eval_not(node, scope) {
    return not eval_expr(node["operand"], scope)
}

def eval_logical(node, scope) {
    if node["op"] == "and" {
        return eval_expr(node["left"], scope) and eval_expr(node["right"], scope)
    }
    return eval_expr(node["left"], scope) or eval_expr(node["right"], scope)
}

def eval_binop(node, scope) {
    let left = eval_expr(node["left"], scope)
    let right = eval_expr(node["right"], scope)
    let op = node["op"]
    if op == "+" {
        return left + right
    }
    if op == "-" {
        return left - right
    }
    if op == "*" {
        return left * right
    }
    if op == "/" {
        return left / right
    }
    if op == "//" {
        return left // right
    }
    if op == "%" {
        return left % right
    }
    raise_error("unknown operator '" + op + "'", node["pos"])
}

def eval_compare(node, scope) {
    let left = eval_expr(node["left"], scope)
    let right = eval_expr(node["right"], scope)
    let op = node["op"]
    if op == "==" {
        return left == right
    }
    if op == "!=" {
        return left != right
    }
    if op == "<" {
        return left < right
    }
    if op == ">" {
        return left > right
    }
    if op == "<=" {
        return left <= right
    }
    if op == ">=" {
        return left >= right
    }
    if op == "in" {
        return left in right
    }
    raise_error("unknown comparison '" + op + "'", node["pos"])
}

def eval_index(node, scope) {
    let target = eval_expr(node["target"], scope)
    let index_value = eval_expr(node["index"], scope)
    return target[index_value]
}

def eval_slice(node, scope) {
    let target = eval_expr(node["target"], scope)
    if node["has_start"] and node["has_end"] {
        return target[eval_expr(node["start"], scope):eval_expr(node["end"], scope)]
    }
    if node["has_start"] {
        return target[eval_expr(node["start"], scope):]
    }
    if node["has_end"] {
        return target[:eval_expr(node["end"], scope)]
    }
    return target[:]
}

def eval_member(node, scope) {
    let target = eval_expr(node["target"], scope)
    if type(target) != "dict" {
        raise_error(target_type(target) + " has no fields, so '." + node["name"] + "' means nothing here", node["pos"])
    }
    return target[node["name"]]
}

def eval_list(node, scope) {
    let items = []
    for item_node in node["items"] {
        append(items, eval_expr(item_node, scope))
    }
    return items
}

def eval_dict(node, scope) {
    let result = {}
    for entry in node["entries"] {
        result[entry["key"]] = eval_expr(entry["value"], scope)
    }
    return result
}

def eval_fstring(node, scope) {
    let text = ""
    for part in node["parts"] {
        text = text + target_str(eval_expr(part, scope))
    }
    return text
}

def eval_expr(node, scope) {
    let kind = node["kind"]
    if kind == "Number" {
        return node["value"]
    }
    if kind == "String" {
        return node["value"]
    }
    if kind == "Boolean" {
        return node["value"]
    }
    if kind == "Var" {
        return eval_var(node, scope)
    }
    if kind == "Unary" {
        return eval_unary(node, scope)
    }
    if kind == "Not" {
        return eval_not(node, scope)
    }
    if kind == "Logical" {
        return eval_logical(node, scope)
    }
    if kind == "BinOp" {
        return eval_binop(node, scope)
    }
    if kind == "Compare" {
        return eval_compare(node, scope)
    }
    if kind == "Call" {
        return eval_call(node, scope)
    }
    if kind == "Index" {
        return eval_index(node, scope)
    }
    if kind == "Slice" {
        return eval_slice(node, scope)
    }
    if kind == "Member" {
        return eval_member(node, scope)
    }
    if kind == "List" {
        return eval_list(node, scope)
    }
    if kind == "Dict" {
        return eval_dict(node, scope)
    }
    if kind == "FString" {
        return eval_fstring(node, scope)
    }
    raise_error("cannot evaluate " + kind, node["pos"])
}

# ---- statements ----------------------------------------------------------

def exec_block(statements, scope) {
    for stmt in statements {
        let result = exec_stmt(stmt, scope)
        if result["kind"] != "normal" {
            return result
        }
    }
    return sig_normal()
}

def exec_scoped_block(block_node, parent_env) {
    return exec_block(block_node["statements"], make_env(parent_env, false, false))
}

def eval_condition(node, scope, keyword) {
    let value = eval_expr(node["condition"], scope)
    if type(value) != "boolean" {
        raise_error("a '" + keyword + "' condition must be true or false, but this is a " + target_type(value), node["pos"])
    }
    return value
}

def exec_if(node, scope) {
    if eval_condition(node, scope, "if") {
        return exec_scoped_block(node["then_block"], scope)
    }
    if node["has_else"] {
        if node["else_block"]["kind"] == "If" {
            return exec_if(node["else_block"], scope)
        }
        return exec_scoped_block(node["else_block"], scope)
    }
    return sig_normal()
}

def exec_while(node, scope) {
    let broke = false
    while eval_condition(node, scope, "while") {
        let result = exec_scoped_block(node["body"], scope)
        if result["kind"] == "break" {
            broke = true
            break
        }
        if result["kind"] == "continue" {
            continue
        }
        if result["kind"] == "return" {
            return result
        }
    }
    if node["has_else"] and not broke {
        return exec_scoped_block(node["else_block"], scope)
    }
    return sig_normal()
}

def loop_number(node, value, role) {
    if type(value) != "number" {
        raise_error(role + " must be a number, but this is a " + target_type(value), node["pos"])
    }
    return value
}

def exec_for(node, scope) {
    let start = loop_number(node, eval_expr(node["start"], scope), "the start of a 'for' range")
    let end = loop_number(node, eval_expr(node["end"], scope), "the end of a 'for' range")
    let step_value = loop_number(node, eval_expr(node["step"], scope), "a 'for' step")
    if step_value <= 0 {
        raise_error("a 'for' step must be greater than zero (use 'downto' to count down)", node["pos"])
    }

    let span = end - start
    if node["descending"] {
        span = start - end
    }
    let iterations = 0
    if span >= 0 {
        iterations = int_floor(span / step_value) + 1
    }

    let loop_env = make_env(scope, false, false)
    let broke = false
    let index = 0
    while index < iterations {
        let offset = index * step_value
        if node["descending"] {
            loop_env["vars"][node["name"]] = start - offset
        } else {
            loop_env["vars"][node["name"]] = start + offset
        }
        let result = exec_block(node["body"]["statements"], make_env(loop_env, false, false))
        if result["kind"] == "break" {
            broke = true
            break
        }
        if result["kind"] == "return" {
            return result
        }
        index = index + 1
    }

    if node["has_else"] and not broke {
        return exec_scoped_block(node["else_block"], scope)
    }
    return sig_normal()
}

def int_floor(v) {
    return v // 1
}

def exec_for_in(node, scope) {
    let collection = eval_expr(node["iterable"], scope)
    let collection_kind = type(collection)
    let ok_kinds = {list: true, string: true, dict: true}
    if not (collection_kind in ok_kinds) {
        raise_error("'for ... in' needs a list, a string or a dictionary, but this is a " + collection_kind, node["pos"])
    }

    let loop_env = make_env(scope, false, false)
    let broke = false

    if node["has_second"] {
        for a, b in collection {
            loop_env["vars"][node["name"]] = a
            loop_env["vars"][node["second_name"]] = b
            let result = exec_block(node["body"]["statements"], make_env(loop_env, false, false))
            if result["kind"] == "break" {
                broke = true
                break
            }
            if result["kind"] == "continue" {
                continue
            }
            if result["kind"] == "return" {
                return result
            }
        }
    } else {
        for a in collection {
            loop_env["vars"][node["name"]] = a
            let result = exec_block(node["body"]["statements"], make_env(loop_env, false, false))
            if result["kind"] == "break" {
                broke = true
                break
            }
            if result["kind"] == "continue" {
                continue
            }
            if result["kind"] == "return" {
                return result
            }
        }
    }

    if node["has_else"] and not broke {
        return exec_scoped_block(node["else_block"], scope)
    }
    return sig_normal()
}

def exec_try(node, scope) {
    let result = sig_normal()
    try {
        try {
            result = exec_scoped_block(node["body"], scope)
        } catch e {
            if not node["has_catch"] {
                throw(e)
            }
            let catch_env = make_env(scope, false, false)
            if node["catch_has_name"] {
                catch_env["vars"][node["catch_name"]] = e
            }
            result = exec_block(node["catch_block"]["statements"], catch_env)
        }
    } finally {
        if node["has_finally"] {
            let finally_result = exec_scoped_block(node["finally_block"], scope)
            if finally_result["kind"] != "normal" {
                result = finally_result
            }
        }
    }
    return result
}

def exec_index_assign(node, scope) {
    let target = eval_expr(node["target"], scope)
    let index_value = eval_expr(node["index"], scope)
    let value = eval_expr(node["value"], scope)
    target[index_value] = value
    return sig_normal()
}

def exec_member_assign(node, scope) {
    let target = eval_expr(node["target"], scope)
    if type(target) != "dict" {
        raise_error("only a dictionary can have fields set, but this is a " + target_type(target), node["pos"])
    }
    target[node["name"]] = eval_expr(node["value"], scope)
    return sig_normal()
}

def exec_delete(node, scope) {
    let target = eval_expr(node["target"], scope)
    if type(target) != "dict" {
        raise_error("delete works on dictionary entries, but this is a " + target_type(target), node["pos"])
    }
    let key = eval_expr(node["key"], scope)
    delete target[key]
    return sig_normal()
}

def exec_delete_file(node, scope) {
    let path = eval_expr(node["path"], scope)
    delete(path)
    return sig_normal()
}

def exec_stmt(node, scope) {
    let kind = node["kind"]

    if kind == "Let" {
        env_define(scope, node["name"], eval_expr(node["value"], scope))
        return sig_normal()
    }
    if kind == "Assign" {
        env_assign(scope, node["name"], eval_expr(node["value"], scope))
        return sig_normal()
    }
    if kind == "IndexAssign" {
        return exec_index_assign(node, scope)
    }
    if kind == "MemberAssign" {
        return exec_member_assign(node, scope)
    }
    if kind == "If" {
        return exec_if(node, scope)
    }
    if kind == "While" {
        return exec_while(node, scope)
    }
    if kind == "For" {
        return exec_for(node, scope)
    }
    if kind == "ForIn" {
        return exec_for_in(node, scope)
    }
    if kind == "Break" {
        return sig_break()
    }
    if kind == "Continue" {
        return sig_continue()
    }
    if kind == "FunctionDef" {
        env_define(scope, node["name"], {kind: "function", name: node["name"], params: node["params"], body: node["body"], closure: scope})
        return sig_normal()
    }
    if kind == "Return" {
        if node["has_value"] {
            return sig_return(eval_expr(node["value"], scope))
        }
        return sig_return(make_nothing())
    }
    if kind == "Try" {
        return exec_try(node, scope)
    }
    if kind == "Throw" {
        let value = eval_expr(node["value"], scope)
        if type(value) != "string" {
            raise_error("throw needs a string, but got a " + target_type(value) + " - use str() to convert it", node["pos"])
        }
        throw(value)
    }
    if kind == "Delete" {
        return exec_delete(node, scope)
    }
    if kind == "DeleteFile" {
        return exec_delete_file(node, scope)
    }
    if kind == "Import" {
        return exec_import(node, scope)
    }
    if kind == "Export" {
        let value = exec_stmt(node["inner"], scope)
        current_exports()[node["inner"]["name"]] = env_get(scope, node["inner"]["name"])
        return value
    }

    eval_expr(node, scope)
    return sig_normal()
}

# ---------------------------------------------------------------------------
# Modules
# ---------------------------------------------------------------------------
#
# A module is loaded by re-entering this same interpreter on a fresh global
# scope, exactly the way a function call gets a fresh frame - see run_module
# below. Paths are canonicalized with the host's own abspath()/dirname(),
# used here only as internal plumbing (not exposed to target programs, the
# way read/write/print are); resolving "math.nova" and "./math.nova" to
# the same absolute path is what makes the module cache and the circular-
# import check trustworthy.

let MODULE_CACHE = {}          # absolute path -> exports dict
let MODULE_LOADING = []        # absolute paths currently being loaded
let FILE_STACK = []            # directories of files currently executing
let EXPORT_STACK = [{}]        # current module's {name: value} being built

def current_dir() {
    if len(FILE_STACK) == 0 {
        return ""
    }
    return FILE_STACK[len(FILE_STACK) - 1]
}

def current_exports() {
    return EXPORT_STACK[len(EXPORT_STACK) - 1]
}

def resolve_import(raw_path, pos) {
    let candidates = []
    if current_dir() != "" {
        append(candidates, current_dir() + "/" + raw_path)
    }
    append(candidates, raw_path)

    for candidate in candidates {
        if exists(candidate) {
            return abspath(candidate)
        }
    }
    raise_error("cannot find module \"" + raw_path + "\" - looked in:\n  " + join(candidates, "\n  "), pos)
}

def default_module_name(raw_path, pos) {
    let name = raw_path
    let slash = -1
    let i = len(name) - 1
    while i >= 0 {
        if name[i:i + 1] == "/" {
            slash = i
            break
        }
        i = i - 1
    }
    if slash >= 0 {
        name = name[slash + 1:]
    }
    let dot = len(name)
    let j = len(name) - 1
    while j >= 0 {
        if name[j:j + 1] == "." {
            dot = j
            break
        }
        j = j - 1
    }
    let stem = name[:dot]
    let valid = len(stem) > 0 and (is_alpha(stem[0:1]))
    let k = 1
    while valid and k < len(stem) {
        if not is_alnum(stem[k:k + 1]) {
            valid = false
        }
        k = k + 1
    }
    if not valid {
        raise_error("\"" + raw_path + "\" does not make a valid module name - import it with 'as' and choose one", pos)
    }
    return stem
}

def run_module(resolved_path, raw_path, pos) {
    if resolved_path in MODULE_CACHE {
        return MODULE_CACHE[resolved_path]
    }
    if resolved_path in MODULE_LOADING {
        let chain = MODULE_LOADING[0]
        let names = ""
        let started = false
        for loading_path in MODULE_LOADING {
            if loading_path == resolved_path {
                started = true
            }
            if started {
                if names != "" {
                    names = names + " -> "
                }
                names = names + default_module_name(loading_path, pos)
            }
        }
        names = names + " -> " + default_module_name(resolved_path, pos)
        raise_error("circular import: " + names, pos)
    }

    let source = read(resolved_path)

    append(MODULE_LOADING, resolved_path)
    append(FILE_STACK, dirname(resolved_path))
    append(EXPORT_STACK, {})

    let exports = {}
    try {
        let ast = parse_program(source)
        let module_env = make_env(false, true, true)
        define_stdlib_globals(module_env)
        exec_block(ast["statements"], module_env)
        exports = current_exports()
    } finally {
        pop(FILE_STACK)
        pop(MODULE_LOADING)
        pop(EXPORT_STACK)
    }

    MODULE_CACHE[resolved_path] = exports
    return exports
}

def exec_import(node, scope) {
    let resolved = resolve_import(node["path"], node["pos"])
    let exports = run_module(resolved, node["path"], node["pos"])

    if node["mode"] == "with" {
        for name in node["names"] {
            if not (name in exports) {
                raise_error("module \"" + node["path"] + "\" has no exported '" + name + "'", node["pos"])
            }
            env_define(scope, name, exports[name])
        }
        return sig_normal()
    }

    let module_name = default_module_name(node["path"], node["pos"])
    if node["mode"] == "as" {
        module_name = node["alias"]
    }
    env_define(scope, module_name, exports)
    return sig_normal()
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def run_program(source, path) {
    append(FILE_STACK, dirname(abspath(path)))
    let ast = parse_program(source)
    let scope = make_env(false, true, true)
    define_stdlib_globals(scope)
    exec_block(ast["statements"], scope)
}

def run_file(path) {
    run_program(read(path), path)
}
